# ---------------------------------------------------------------------
# Supabase — project URL and keys from the Supabase dashboard
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security — never expose to the browser
# and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# Super-admin seed (scripts/seed-super-admin.ts)
# Set these at deploy time only. Do not commit real credentials.
# ---------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# Email — confirmation mail for registered teams
# Leave RESEND_API_KEY blank in development; sends are logged and skipped.
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="PIEMR Hackathon <hackathon@piemr.edu.in>"
