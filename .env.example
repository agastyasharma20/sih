# ---------------------------------------------------------------------
# Supabase — Project Settings → API
#
# Supabase renamed its keys in 2025. Projects created from November 2025
# onwards only have the new ones:
#
#   Publishable key  sb_publishable_…   (was: anon / public)
#   Secret key       sb_secret_…        (was: service_role)
#
# Either variable name works for each; the app checks the new name first.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The sb_publishable_… key. Safe in the browser — Row-Level Security
# gates every query it makes.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Older projects may still use: NEXT_PUBLIC_SUPABASE_ANON_KEY

# The sb_secret_… key. Bypasses Row-Level Security entirely.
# Server-side only. Never commit a real value, never prefix it with
# NEXT_PUBLIC_, never paste it into a screenshot.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
# Older projects may still use: SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------
# Super-admin seed (scripts/seed-super-admin.ts)
# Set these at deploy time only. Do not commit real credentials.
# ---------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# Email — confirmation mail for registered teams
# Leave RESEND_API_KEY blank in development; sends are logged and skipped.
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="PIEMR Hackathon <hackathon@piemr.edu.in>"
